# Node.js
node_modules/
npm-debug.log

# Terraform state - contains sensitive infrastructure details, never commit
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Terraform working directory - local cache, regenerated by `terraform init`
.terraform/

# Terraform variable files - may contain secrets/credentials
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log

# Environment variables - may contain secrets
.env

# OS/editor junk files
.DS_Store